{
  "name": "can-i-walk-my-dog-today",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "web": "cd packages/web && npm run dev",
    "mobile": "cd packages/mobile && npm start",
    "build:web": "cd packages/web && npm run build",
    "build:shared": "cd packages/shared && npm run build",
    "test": "npm run test:web && npm run test:mobile",
    "test:web": "cd packages/web && npm test",
    "test:mobile": "cd packages/mobile && npm test",
    "lint": "npm run lint:web && npm run lint:mobile && npm run lint:shared",
    "lint:web": "cd packages/web && npm run lint",
    "lint:mobile": "cd packages/mobile && npx tsc --noEmit",
    "lint:shared": "cd packages/shared && npx tsc --noEmit",
    "typecheck": "npm run lint:mobile && npm run lint:shared"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}